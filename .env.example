# ============================================================================
# Tamarind Tree HRMS — environment template
# Copy to .env.local and fill in. NEVER commit .env.local.
# ============================================================================

# --- Client-side (safe to ship in the browser bundle) ---------------------
# Anything prefixed VITE_ is compiled INTO the client bundle. Only ever put
# publishable/anon values here — never a secret key.
VITE_SUPABASE_URL=https://aygxkkoltwltczfdbplr.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
VITE_APP_NAME=Tamarind Tree HRMS
VITE_APP_TIMEZONE=Asia/Kolkata

# --- Server-side ONLY -----------------------------------------------------
# These must NOT appear in any VITE_ variable and must NOT be committed.
# Set them as Supabase Edge Function secrets:
#   npx supabase secrets set --env-file ./supabase/.env.secrets
#
# SUPABASE_SERVICE_ROLE_KEY  sb_secret_...  (bypasses RLS — kiosk punch fn,
#                                            payroll engine, imports, audit export)
# ANTHROPIC_API_KEY          sk-ant-...     (AI infographic agent)
# RESEND_API_KEY             re_...         (transactional email)
# KIOSK_DEVICE_SIGNING_SECRET                (HMAC for kiosk device tokens)
# CRON_SECRET                                (authenticates scheduled job calls)

# --- Local tooling (not used at runtime) ----------------------------------
# SUPABASE_ACCESS_TOKEN=sbp_...   # personal access token for `supabase link` / `db push`
# SUPABASE_DB_PASSWORD=...        # database password for direct psql / db push
